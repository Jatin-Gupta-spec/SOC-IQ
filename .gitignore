# ============================================================
# SOC-IQ .gitignore
# Audited against the CURRENT working tree (Python backend,
# React/TS/Vite frontend, Tauri desktop shell, sidecar-core,
# keystore-core). Generated-artifact rules only — no blanket
# directory ignores for source, tests, docs, migrations, or
# packaging.
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
.eggs/
build/
dist/

# Coverage output (not docs/fixtures that merely mention "coverage")
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------- Environment / secrets ----------
# Real env files are never committed. app/secrets/*.py is
# SOURCE CODE (keystore handoff implementation) and is
# intentionally NOT matched by any rule below.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.der
secrets.json
credentials.json
*.secret

# ---------- Node / frontend (Vite + TS) ----------
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Rust / Cargo (src-tauri, sidecar-core, keystore-core) ----------
# Cargo.toml and Cargo.lock stay tracked (reproducible builds).
src-tauri/target/
sidecar-core/target/
keystore-core/target/
target/
**/*.rs.bk
*.pdb

# ---------- Tauri build/generated artifacts ----------
src-tauri/gen/
src-tauri/WixTools/
src-tauri/target/

# ---------- Local database / runtime state ----------
# Migrations under app/database/migrations/ are source-controlled
# and are NOT matched by these patterns.
database/*.db
database/*.sqlite
database/*.sqlite3
database/*.db-journal
database/*.db-wal
database/*.db-shm
*.db-journal

# ---------- Packaging / build output ----------
# packaging/scripts, packaging/pyinstaller specs, and packaging
# docs stay tracked — only generated installer output is ignored.
packaging/dist/
packaging/build/
packaging/*.exe
packaging/*.msi
packaging/*.dmg
packaging/*.AppImage

# ---------- Logs / runtime / temp ----------
*.log
logs/
*.tmp
*.temp
*.pid
*.lock.local
crash-dumps/

# ---------- IDE / editor metadata ----------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# ---------- OS-generated ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
